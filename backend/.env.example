# StreamHub backend environment
#
# Copy to .env.local for development (`yarn dev`, `yarn worker`).
# Production reads .env on the server (`yarn start`).
# Placeholders only. Never put real values in this file.
# When code adds a new process.env.X, add it here in the same change.
#
# [required]  the app fails or a core feature breaks without it
# [optional]  has a working default, or only needed for that feature

# ---------------------------------------------------------------- Core
NODE_ENV=development                       # [required] development | production
PORT=3001                                  # [optional] default 3001
LOG_LEVEL=info                             # [optional] error | warn | info | debug

# MongoDB connection string, the only database variable the app reads.
# `yarn docker:up` runs Mongo on 27018 with a root login (password from MONGO_PASSWORD in docker-compose.yml).
# A local install without auth: mongodb://localhost:27017/streamhub. Atlas: mongodb+srv://<user>:<password>@<cluster>/streamhub
DATABASE_URL=mongodb://admin:<password>@localhost:27018/streamhub?authSource=admin   # [required]

# Signs access and refresh tokens. Generate with: openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-string       # [required]

# Frontend origin for CORS, and the base for links in emails.
CLIENT_URL=http://localhost:3000           # [required in production]
CORS_ORIGIN=http://localhost:3000          # [optional] defaults to CLIENT_URL
FRONTEND_URL=http://localhost:3000         # [required] password-reset links, AI streamer links

# HTTPS served directly by Node (production only; omit behind a proxy).
SSL_KEY_PATH=                              # [optional] /path/to/privkey.pem
SSL_CERT_PATH=                             # [optional] /path/to/fullchain.pem

# ---------------------------------------------------------------- Redis
REDIS_HOST=localhost                       # [optional] default localhost
REDIS_PORT=6379                            # [optional] default 6379
REDIS_PASSWORD=                            # [optional]
REDIS_DB=0                                 # [optional] default 0

# ---------------------------------------------------------------- Media (mediasoup / WebRTC)
# Public IP of the server. Development auto-detects it; production must set it,
# otherwise viewers connect but receive no video.
ANNOUNCED_IP=                              # [required in production]

# UDP port range for WebRTC. Open it in the firewall (and the Oracle security list).
RTC_MIN_PORT=40000                         # [optional] default 40000
RTC_MAX_PORT=49999                         # [optional] default 49999
MAX_WORKERS=8                              # [optional] mediasoup workers, about 1 per CPU core

# ---------------------------------------------------------------- Queue (VOD conversion)
# Optional. Without RabbitMQ, recordings upload to R2 directly as WebM.
RABBITMQ_URL=amqp://localhost:5672         # [optional]

# ---------------------------------------------------------------- Storage (Cloudflare R2)
# Avatars, VODs and podcast audio. R2_PUBLIC_URL is needed for files to load in the browser.
R2_ACCOUNT_ID=                             # [required for uploads]
R2_ACCESS_KEY_ID=                          # [required for uploads]
R2_SECRET_ACCESS_KEY=                      # [required for uploads]
R2_BUCKET_NAME=                            # [required for uploads]
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev  # [required for uploads]

# ---------------------------------------------------------------- Email (Brevo SMTP)
# Password-reset emails.
BREVO_SMTP_LOGIN=                          # [required for password reset]
BREVO_SMTP_KEY=                            # [required for password reset]
MAIL_FROM="StreamHub <no-reply@example.com>"  # [required for password reset]

# ---------------------------------------------------------------- AI (streamer and podcast)
# The server currently fails to start without GEMINI_API_KEY, even if AI is unused.
GEMINI_API_KEY=                            # [required]
LLM_PROVIDER=gemini                        # [optional] gemini | ollama
LLM_MODEL=                                 # [optional] overrides the default Gemini models
LLM_REQUEST_TIMEOUT_MS=120000              # [optional]
OLLAMA_BASE_URL=http://localhost:11434     # [optional] only with LLM_PROVIDER=ollama

# Google Cloud Text-to-Speech service-account key. Absolute path, kept OUTSIDE the repo.
GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.config/streamhub/gcp-tts-key.json   # [required for AI audio]

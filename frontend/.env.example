# StreamHub frontend environment
#
# Copy to .env.local. NEXT_PUBLIC_* values are baked in at build time: rebuild after changing them.
# Placeholders only. Never put real values in this file.

# Backend origin for REST and Socket.IO.
# Production: your backend's public URL, e.g. https://api.example.com
# Don't leave these empty: the code then falls back to http://localhost:3001.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# GIF picker in chat (get a key at developers.giphy.com). Public by design.
NEXT_PUBLIC_GIPHY_API_KEY=
